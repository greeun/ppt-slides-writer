        </mxCell>
        <mxCell id="step2" value="Step 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="160" y="280" width="70" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="step3" value="Step 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="260" y="280" width="70" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="step4" value="Step 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="360" y="280" width="70" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="step5" value="Step 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="460" y="280" width="70" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="step6" value="Done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1306C;strokeColor=#C13584;fontColor=#ffffff;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="560" y="280" width="70" height="40" as="geometry"/>
        </mxCell>

        <!-- Workflow Arrows -->
        <mxCell id="wf1" style="edgeStyle=none;rounded=0;html=1;strokeWidth=1;strokeColor=#0e8088;endArrow=classic" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="wf2" style="edgeStyle=none;rounded=0;html=1;strokeWidth=1;strokeColor=#0e8088;endArrow=classic" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="wf3" style="edgeStyle=none;rounded=0;html=1;strokeWidth=1;strokeColor=#0e8088;endArrow=classic" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="wf4" style="edgeStyle=none;rounded=0;html=1;strokeWidth=1;strokeColor=#0e8088;endArrow=classic" edge="1" parent="1" source="step4" target="step5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="wf5" style="edgeStyle=none;rounded=0;html=1;strokeWidth=1;strokeColor=#0e8088;endArrow=classic" edge="1" parent="1" source="step5" target="step6">
          <mxGeometry relative="1" as="geometry"/>
