        </mxCell>
        <mxCell id="output2" value="Output B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="810" y="135" width="70" height="35" as="geometry"/>
        </mxCell>

        <!-- ============================================================ -->
        <!-- Flow Arrows: exitX/Y, entryX/Y 명시로 화살표 경로 제어 -->
        <!-- ============================================================ -->

        <!-- Stage 1 → Stage 2: 수평 흐름 (오른쪽 방향) -->
        <mxCell id="flow1"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5"
          edge="1" parent="1" source="queue" target="proc1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Stage 2 → Stage 3: 수평 흐름 -->
        <mxCell id="flow2"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5"
          edge="1" parent="1" source="ai-engine" target="trans1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Stage 3 → Stage 4: 수평 흐름 -->
        <mxCell id="flow3"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5"
          edge="1" parent="1" source="human" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 내부 흐름: Source → Collector (수직 하향) -->
        <mxCell id="flow-src-collector"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;strokeColor=#999999;exitX=0.5;exitY=1;entryX=0.25;entryY=0"
          edge="1" parent="1" source="src1" target="collector">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 내부 흐름: Collector → Normalizer (수직 하향) -->
        <mxCell id="flow-collector-norm"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;strokeColor=#999999;exitX=0.25;exitY=1;entryX=0.5;entryY=0"
          edge="1" parent="1" source="collector" target="normalizer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Workflow (Bottom) -->
        <mxCell id="workflow-bg" value="워크플로우" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;opacity=50;verticalAlign=top;fontStyle=1;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="860" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="step1" value="Step 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=9" vertex="1" parent="1">
